# Copy to .env next to compose.yml and change what you need.

# The address(es) you open KRNL0 by, so the certificate covers them (comma-separated).
KRNL0_HOSTS=192.168.1.20,krnl0.local

# Your time zone, so days start at your midnight.
TZ=Europe/Berlin

# What this server does: on / off
KRNL0_WEBSITE=on
KRNL0_APP_SYNC=on

# Encryption: self-signed (nothing to set up) | files | proxy
KRNL0_TLS=self-signed

# Daily check for a new version on GitHub (nothing else is sent anywhere).
KRNL0_UPDATE_CHECK=on

# Update by itself at night (04:00), signed releases only: on / off
KRNL0_AUTO_UPDATE=off

# Pin a version instead of latest, e.g. 0.1.0 (no one-click updates while pinned)
# KRNL0_VERSION=latest

# Own domain with the Caddy profile (docker compose --profile domain up -d):
# KRNL0_DOMAIN=krnl0.example.com
# KRNL0_TRUST_PROXY=on
# KRNL0_PUBLISH_PORT=127.0.0.1:8443
