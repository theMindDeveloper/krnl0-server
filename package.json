{
  "name": "krnl0-server",
  "version": "0.2.7",
  "description": "Self-hosted KRNL0: the website and sync for the KRNL0 app, on your own server",
  "license": "MIT",
  "author": {
    "name": "theMindDeveloper",
    "email": "theminddevlab@gmail.com"
  },
  "type": "module",
  "engines": {
    "node": ">=24.7.0"
  },
  "bin": {
